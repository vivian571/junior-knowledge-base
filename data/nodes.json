 {
  "id": "qd-m7a-101",
  "subject": "数学",
  "name": "正数与负数的概念",
  "loc": "1.1 p3",
  "type": "概念",
  "level": "节点",
  "status": "待校准",
  "source": "cn-math-taxonomy借鉴",
  "definition": "在小学认识负数的基础上，明确正数、负数、0 的含义；0 既不是正数也不是负数。",
  "mastery": "能判断一个数是正数、负数还是 0；能说出 0 的特殊地位。",
  "diagnostic": "下列数中哪些是负数：-3，0，+2.5，-1/2？（答：-3 和 -1/2）",
  "root_note": "判断错多半错在 0 的归属，回本节定义即可。",
  "tier": "",
  "part_of": "qd-m7a-A1"
 },
 {
  "id": "qd-m7a-102",
  "subject": "数学",
  "name": "用正负数表示相反意义的量",
  "loc": "1.1 p3",
  "type": "应用",
  "level": "节点",
  "status": "待校准",
  "source": "cn-math-taxonomy借鉴",
  "definition": "用正数和负数表示具有相反意义的量，如盈亏、增减、海拔高低。",
  "mastery": "能把实际情境中的相反量用正负数表示；能解释正负数在情境中的含义。",
  "diagnostic": "若向东走 5 m 记作 +5 m，则 -3 m 表示什么？（答：向西走 3 m）",
  "root_note": "错在基准没定：先问以什么为 0、哪个方向为正，再谈符号。",
  "tier": "",
  "part_of": "qd-m7a-A1"
 },
 {
  "id": "qd-m7a-103",
  "subject": "数学",
  "name": "有理数的分类",
  "loc": "1.2 p7",
  "type": "概念",
  "level": "节点",
  "status": "待校准",
  "source": "cn-math-taxonomy借鉴",
  "definition": "整数和分数统称有理数；会按整数/分数或正数/0/负数两种方式分类。",
  "mastery": "能说出有理数的定义；能按两种标准分类。",
  "diagnostic": "把 -2，0，3.5，-1/3，7 按正数、0、负数分类。（答：正数 3.5，7；0；负数 -2，-1/3）",
  "root_note": "分类错先查两个口子：0 的归属（回 101）；有限/循环小数算不算分数（回小学分数意义）。",
  "tier": "",
  "part_of": "qd-m7a-A1"
 },
 {
  "id": "qd-m7a-104",
  "subject": "数学",
  "name": "数轴",
  "loc": "1.3 p10",
  "type": "概念",
  "level": "节点",
  "status": "待校准",
  "source": "cn-math-taxonomy借鉴",
  "definition": "规定了原点、正方向和单位长度的直线叫数轴。",
  "mastery": "能说出数轴三要素；能判断一条直线是不是数轴。",
  "diagnostic": "画数轴只有原点和正方向，缺哪一要素就不合格？（答：单位长度）",
  "root_note": "105–109 的错有一半源头在此：单位长度不统一会让表示、比较全跟着错。",
  "tier": "",
  "part_of": "qd-m7a-A1"
 },
 {
  "id": "qd-m7a-105",
  "subject": "数学",
  "name": "在数轴上表示有理数",
